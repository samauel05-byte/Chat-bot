# Trigger.dev (dev environment secret key from your project's API Keys page)
TRIGGER_SECRET_KEY=

# Anthropic (used for chat + invoice extraction, needs a vision-capable model)
ANTHROPIC_API_KEY=

# Vercel Blob (Storage tab in the Vercel dashboard -> Create -> Blob -> Connect Project;
# it auto-fills this locally too via `vercel env pull`, or copy it manually)
BLOB_READ_WRITE_TOKEN=
