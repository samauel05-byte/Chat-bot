# Trigger.dev (dev environment secret key from your project's API Keys page)
TRIGGER_SECRET_KEY=

# Anthropic (used for chat + invoice extraction, needs a vision-capable model)
ANTHROPIC_API_KEY=

# Vercel Blob (Storage tab in the Vercel dashboard -> Create -> Blob -> Connect Project;
# it auto-fills this locally too via `vercel env pull`, or copy it manually)
BLOB_READ_WRITE_TOKEN=

# Clerk (multi-tenant auth — https://clerk.com → create app → copy keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/

# Admin panel — set to your own Clerk user ID to restrict /admin access
# (find it in the Clerk dashboard under Users → your account → User ID)
ADMIN_USER_ID=
# Used in email invitations as the sign-in redirect target
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
# Expose admin user ID client-side so the ⚙️ Admin link is shown in the header
NEXT_PUBLIC_ADMIN_USER_ID=
