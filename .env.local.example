# Trigger.dev (dev environment secret key from your project's API Keys page)
TRIGGER_SECRET_KEY=

# OpenAI (used for chat + invoice extraction, needs a vision-capable model)
OPENAI_API_KEY=

# Vercel Blob (Storage tab in the Vercel dashboard -> Create -> Blob -> Connect Project;
# it auto-fills this locally too via `vercel env pull`, or copy it manually)
BLOB_READ_WRITE_TOKEN=

# Supabase: URL y Publishable Key (son públicos y se protegen con RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
